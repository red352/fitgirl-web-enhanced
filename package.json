{
  "name": "fitgirl-web-enhanced",
  "version": "1.2.0",
  "description": "面向 FitGirl Repacks 的响应式、可访问 Userscript 界面增强。",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "LuoYunXiao",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fixture": "vite --config test/e2e/vite.config.ts",
    "test:e2e": "npm run build && playwright test",
    "test:live": "npm run build && node test/live-qa.mjs",
    "check": "npm run lint && npm run format:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.13",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.2.2",
    "vite-plugin-monkey": "^8.1.1",
    "vitest": "^4.1.11"
  }
}
